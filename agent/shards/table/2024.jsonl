{"name": "NEWRACE2", "label": "RC-RACE/HISPANICITY RECODE (7 LEVELS)", "questions": [{"text": "Because the reordering of the response options in alphabetical order in the 2022 NSDUH placed “American Indian or Alaska Native” as the first option, the unweighted number of non-Hispanic American Indian or Alaska Native respondents increased from prior years. Additionally, in 2023, the race and ethnicity questions in the in-person questionnaire became self-administered instead of being administered by an interviewer, which again seems to have increased the size of the unweighted “American Indian or Alaska Native” sample. Despite the weighted population size for non-Hispanic American Indian or Alaska Native people being consistent between years, caution is advised in comparing outcomes for this group over time due to the change in the unweighted number of respondents."}], "storage_type": "integer", "measure": "categorical", "values": [{"code": 1, "label": "NonHisp White", "kind": "valid"}, {"code": 2, "label": "NonHisp Black/Afr Am", "kind": "valid"}, {"code": 3, "label": "NonHisp Native Am/AK Native", "kind": "valid"}, {"code": 4, "label": "NonHisp Native HI/Other Pac Isl", "kind": "valid"}, {"code": 5, "label": "NonHisp Asian", "kind": "valid"}, {"code": 6, "label": "NonHisp more than one race", "kind": "valid"}, {"code": 7, "label": "Hispanic", "kind": "valid"}], "availability": {"all": "2024"}, "source_location": {"source": "nsduh-2024-codebook", "page": 15}, "origins": {"record": "publisher:nsduh-2024-codebook", "storage_type": "rule:storage_type_from_values@0.1", "availability": "data_file:nsduh-2024-stata", "measure": "hand:Claude (PublicDataToolkit Task 60)"}, "view": {"release": "2024", "groups": ["module-recoded-demographics"]}}
